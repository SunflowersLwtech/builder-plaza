<?xml version="1.0" encoding="utf-8"?>
<!-- Scoped to just the demo ALB (HTTP only, no ACM cert on the student AWS
     account; see docs/DEPLOYMENT.md and REPORT.md "Known limitations").
     Cleartext stays blocked for every other host the app talks to (GitHub
     avatars, S3 presigned uploads, LinkedIn OIDC, etc.) instead of setting
     android:usesCleartextTraffic="true" app-wide. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">builder-plaza-alb-270417897.ap-southeast-1.elb.amazonaws.com</domain>
        <!-- Loopback only: 10.0.2.2 is the emulator's alias for the host
             machine, so `flutter run` and the CI e2e/crawl jobs can reach a
             local uvicorn. Neither address is routable from a real phone. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Dev laptop on the LAN, for `flutter run` against a local uvicorn
             from a real handset (10.0.2.2 is emulator-only). Update to match
             `ipconfig getifaddr en0` if the machine's DHCP lease changes. -->
        <domain includeSubdomains="false">192.168.100.228</domain>
    </domain-config>
</network-security-config>
